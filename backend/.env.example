# 서버
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# 데이터베이스 - 기본값은 SQLite라 별도 DB 설치 없이 바로 실행 가능
DATABASE_URL="file:./dev.db"
# Postgres로 바꾸려면:
# 1) prisma/schema.prisma의 datasource provider를 "postgresql"로 변경
# 2) 아래처럼 DATABASE_URL 설정
# DATABASE_URL="postgresql://user:password@localhost:5432/ar_fashion"

# AI 컨시어지 챗봇 (선택 사항)
# 설정하지 않으면 프론트엔드의 기존 Mock 응답과 동일한 형태로 자동 대체됩니다.
ANTHROPIC_API_KEY=
